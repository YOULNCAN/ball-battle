{
  "name": "ball-battle",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "build:pages": "tsc --noEmit && vite build --mode pages",
    "test:pages": "node tests/pages.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:browser": "node tests/browser.mjs",
    "test:pressure": "node tests/pressure.mjs",
    "test:production": "node tests/production.mjs",
    "test:upgrade": "node tests/upgrade-browser.mjs",
    "test:war-pressure": "node tests/war-pressure.mjs",
    "test:mixed": "node tests/mixed-browser.mjs",
    "test:balance": "node tests/balance.mjs",
    "test:land-production": "node tests/production-browser.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^4.1.11"
  }
}
